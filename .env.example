# ============================================================
# DOMINO Landing Page & Admin CMS — Vercel + Supabase Config
# ============================================================

# Supabase (Database PostgreSQL + Storage)
# Lấy tại: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=domino-media

# Security Secrets (BẮT BUỘC đặt trên Vercel Environment Variables!)
# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-very-long-random-secret-key-in-production
COOKIE_SECRET=change-this-to-another-random-secret-key-in-production

# Default Admin Account (tự động tạo khi bảng admins trống — đổi mật khẩu ngay sau khi đăng nhập)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Domino@2026!Secure

# Local Development Only (Vercel tự động quản lý PORT & NODE_ENV)
PORT=3000
NODE_ENV=development
