# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Security Secrets (CHANGE THESE IN PRODUCTION!)
# Generate strong random strings: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-very-long-random-secret-key-in-production
COOKIE_SECRET=change-this-to-another-random-secret-key-in-production

# Default Admin Account (used only on initial DB seed - change password immediately after login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Domino@2026!Secure

# Optional: Trust reverse proxy (Nginx / Cloudflare) - set to 1 in production behind proxy
TRUST_PROXY=0

